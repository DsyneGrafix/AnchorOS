# Local SQLite runtime state
data/*.db
data/*.db-wal
data/*.db-shm
data/backups/
backups/
*-backup/
*-failed/

# Customer-uploaded evidence is runtime data, never source control.
data/evidence-files/*
!data/evidence-files/.gitignore

# Generated BOOT lifecycle archives are runtime data, never source control.
data/archives/*
!data/archives/.gitignore

# Python runtime artifacts
__pycache__/
*.py[cod]
*.zip
